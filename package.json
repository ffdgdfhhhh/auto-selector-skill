{
  "name": "auto-selector-skill",
  "version": "1.6.0",
  "description": "Always-on skill & plugin selector for Claude Code. Scans installed skills/plugins, analyzes user tasks, selects the best match, asks for confirmation before invoking.",
  "license": "MIT",
  "author": "ffdgdfhhhh",
  "homepage": "https://github.com/ffdgdfhhhh/auto-selector-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffdgdfhhhh/auto-selector-skill.git"
  },
  "bugs": {
    "url": "https://github.com/ffdgdfhhhh/auto-selector-skill/issues"
  },
  "bin": {
    "auto-selector-skill": "./bin/install.js"
  },
  "scripts": {
    "test": "node scripts/test.js",
    "check": "node scripts/sync-docs.js --check && node scripts/check-versions.js",
    "check:pack": "node scripts/check-package.js",
    "sync-docs": "node scripts/sync-docs.js",
    "doctor": "node src/cli/doctor.js",
    "eval": "node src/cli/eval.js",
    "test:mcp": "node mcp-server/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "skill",
    "router",
    "selector",
    "mcp",
    "ai-agent"
  ],
  "files": [
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    "bin/",
    "src/",
    "skills/",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "INSTALL.md",
    "LICENSE"
  ]
}
